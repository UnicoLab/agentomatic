{
  "pythonVersion": "3.11",
  "venvPath": ".",
  "venv": ".venv",
  "include": ["src", "tests"],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/.venv",
    "**/dist",
    "**/site",
    "**/build"
  ],
  "typeCheckingMode": "standard",
  "reportMissingImports": "error",
  "reportMissingModuleSource": "none",
  "reportCallIssue": "error",
  "reportArgumentType": "error",
  "reportAssignmentType": "error",
  "reportReturnType": "error",
  "reportAttributeAccessIssue": "error",
  "reportOptionalMemberAccess": "error",
  "reportOptionalCall": "error",
  "reportOptionalSubscript": "error",
  "reportIndexIssue": "error",
  "reportOperatorIssue": "error",
  "reportGeneralTypeIssues": "error",
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning",
  "reportUnusedExpression": "warning",
  "reportUnusedClass": "warning",
  "reportUnusedFunction": "none",
  "reportUnusedCallResult": "none",
  "reportUnnecessaryIsInstance": "warning",
  "reportUnnecessaryCast": "warning",
  "reportUnnecessaryComparison": "warning",
  "reportUnnecessaryContains": "warning",
  "reportUnnecessaryTypeIgnoreComment": "warning",
  "reportPrivateUsage": "none",
  "reportIncompatibleMethodOverride": "warning",
  "reportIncompatibleVariableOverride": "warning",
  "reportUninitializedInstanceVariable": "warning",
  "reportSelfClsParameterName": "warning",
  "reportUnusedParameter": "none",
  "reportUnusedCoroutine": "warning",
  "reportDeprecated": "warning",
  "reportImplicitStringConcatenation": "none",
  "reportPropertyTypeMismatch": "warning",
  "reportTypeCommentUsage": "warning",
  "reportMissingSuperCall": "none",
  "reportUntypedBaseClass": "none",
  "reportUntypedFunctionDecorator": "none",
  "reportUntypedClassDecorator": "none",
  "reportUntypedNamedTuple": "none",
  "reportInvalidTypeVarUse": "warning",
  "reportMissingTypeArgument": "none",
  "reportMissingParameterType": "warning",
  "reportUnknownParameterType": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownVariableType": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownLambdaType": "none",
  "reportUnknownImportType": "none",
  "reportAny": "none",
  "reportExplicitAny": "none",
  "reportMissingTypeStubs": "none",
  "reportImportCycles": "none",
  "reportShadowedImports": "none",
  "reportDuplicateImport": "warning",
  "reportWildcardImportFromLibrary": "warning",
  "reportAbstractUsage": "warning",
  "reportInconsistentConstructor": "warning",
  "reportFunctionMemberAccess": "warning",
  "reportRedeclaration": "warning",
  "reportInconsistentOverload": "warning",
  "reportOverlappingOverload": "warning",
  "reportMatchNotExhaustive": "none",
  "reportAssertAlwaysTrue": "none",
  "reportUnusedExcept": "warning",
  "overrides": [
    {
      "files": ["tests/**"],
      "comment": "Test suites rely on MagicMock and untyped fixtures; keep semantic checks but relax mock-noise rules for tests.",
      "reportMissingParameterType": "none",
      "reportCallIssue": "none",
      "reportArgumentType": "none",
      "reportAttributeAccessIssue": "none"
    }
  ]
}
